# The Machinedrum and Monomachine Editors' names: the one place they are set.
#
# Read by the build (source/elektron/md/mdJucePlugin/mdmmPlugins.cmake: the bundle and executable
# names, the plug-in name a DAW shows, the window titles, the vendor) and sourced by the packaging,
# signing and test scripts (scripts/macos/*.sh, scripts/windows/*.ps1, scripts/mdmm-*.sh).
# Plain KEY="value" lines only: sh, CMake and PowerShell all parse them.
#
# Changing a name here renames every bundle, executable and installer page. It does not move
# anything a user already has: the data and ROM folders (~/Documents/Gearmulator Preview/<machine>)
# and the settings files are fixed elsewhere and stay. The plug-in codes (the AU codes and, derived
# from them, the VST3 class IDs) are set at the end of this file. The site (site/public) and the docs
# are text: update them too (scripts/check_mdmm_names.sh finds the old names).

MDMM_PRODUCT_NAME_MD="Machinedrum Editor"
MDMM_PRODUCT_NAME_MM="Monomachine Editor"

# The maker a DAW shows (AU "Future Native Audio: Machinedrum Editor", the VST3 vendor, the Windows file details).
MDMM_VENDOR="Future Native Audio"
MDMM_WEBSITE="https://mdmm.dev"

# The bundle names up to 0.3.1, the same as the original Gearmulator MD / MM plug-ins (joelanders' builds).
# The installers remove a bundle at these names only when it is provably ours (our identifier below, or our
# package's receipt lists it: scripts/macos/pkg-resources/remove-old-bundles); the original ones stay.
MDMM_LEGACY_NAME_MD="Gearmulator MD"
MDMM_LEGACY_NAME_MM="Gearmulator MM"

# The macOS bundle identifiers (app, VST3 and AU alike). The editors' own since 0.3.1; up to 0.3.0 the bundles
# carried upstream Gearmulator's local.gearmulator.preview.GearmulatorMD / MM instead (doc/release/SIGNING.md,
# "Identifiers"), as the original Gearmulator MD / MM still do. That identifier no longer marks a bundle as ours:
# from the release after 0.5.x the codes differ, so the original plug-ins may stay installed beside the editors.
# scripts/release/test_release_scripts.py checks the current two against mdmmPlugins.cmake.
MDMM_BUNDLE_ID_MD="com.nativekloud.machinedrum-editor"
MDMM_BUNDLE_ID_MM="com.nativekloud.monomachine-editor"
MDMM_LEGACY_BUNDLE_ID_MD="local.gearmulator.preview.GearmulatorMD"
MDMM_LEGACY_BUNDLE_ID_MM="local.gearmulator.preview.GearmulatorMM"

# The plug-in identity: the Audio Units' codes (aumu, subtype + manufacturer), and from them the VST3 class IDs
# (JUCE, JUCE_VST3_CAN_REPLACE_VST2=0: processor ABCDEF01 9182FAEB <manufacturer> <subtype>, controller ABCDEF01
# 1234ABCD <manufacturer> <subtype>, hex of the four characters). Future Native Audio's own after 0.5.x: FNAu is
# the company's manufacturer code (RND-4X uses it too); Mded / Mmed are the editors' (JUCE: four letters, the first
# the only upper-case one). Read by mdmmPlugins.cmake (PLUGIN_CODE, PLUGIN_MANUFACTURER_CODE through juce.cmake's
# hook) and by the packaging and test scripts; scripts/check_mdmm_plugin_ids.py checks the built bundles agree.
# Changing them makes every DAW project that uses the plug-ins look for one that is no longer there.
MDMM_AU_SUBTYPE_MD="Mded"
MDMM_AU_SUBTYPE_MM="Mmed"
MDMM_AU_MANUFACTURER="FNAu"

# The codes up to 0.5.x: upstream Gearmulator's maker GmPv with Tmdr / Tmno, the same as the original Gearmulator
# MD / MM, so macOS kept one of the two Audio Units and a host one of the two VST3 classes (B-048). The build never
# uses them; the AU preinstall removes an old copy of OUR editor that registers them (our identifier or receipt
# only), and the tests check the build no longer carries them.
MDMM_LEGACY_AU_SUBTYPE_MD="Tmdr"
MDMM_LEGACY_AU_SUBTYPE_MM="Tmno"
MDMM_LEGACY_AU_MANUFACTURER="GmPv"
